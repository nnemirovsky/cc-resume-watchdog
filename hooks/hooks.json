{
  "description": "resume-watchdog - arms a per-session resume watch for transient API stream failures",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/arm-watchdog.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/rewake-watch.sh",
            "async": true,
            "asyncRewake": true,
            "rewakeMessage": "Resume watchdog:"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/arm-watchdog.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
