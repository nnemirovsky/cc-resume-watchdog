{
  "description": "resume-watchdog - keeps one watcher alive that wakes Claude Code after a transient API stream failure",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/arm.sh",
            "async": true,
            "asyncRewake": true,
            "rewakeMessage": "Resume watchdog:"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/arm.sh",
            "async": true,
            "asyncRewake": true,
            "rewakeMessage": "Resume watchdog:"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/arm.sh",
            "async": true,
            "asyncRewake": true,
            "rewakeMessage": "Resume watchdog:"
          }
        ]
      }
    ]
  }
}
