#!/usr/bin/env bash
# cc-resume-watch - wake Claude Code when a turn is killed by a *transient* API
# stream failure and nothing continues it.
#
# Usage: cc-resume-watch <transcript.jsonl> [grace_secs] [poll_secs] [max_per_hour]
#
# Env:
#   CC_RESUME_STATE  state file prefix. <prefix>.resumed is the uuid ledger,
#                    <prefix>.fired the rate-limit log, <prefix>.pid the singleton
#                    marker this process owns, <prefix>.log why watchers exited.
#   CC_RESUME_WINDOW rate-limit window in seconds. Default 3600.
#   CC_RESUME_OWNER  Claude Code's pid. The watcher exits once it dies. Resolved
#                    from the session registry when unset, and if the registry has
#                    nothing to say, the watcher follows its own parent instead.
#
# Run from a hook declared async + asyncRewake. On a hit it writes the resume
# instruction to stderr and exits 2, and Claude Code turns that into a wake-up
# for the model. That is one shot, because the rewake fires on process exit, so
# the arming hook re-spawns a fresh watcher on the next prompt or tool call.
#
# All cross-process state lives on disk precisely because each watcher is
# short-lived: the ledger stops one drop being resumed twice by two generations
# of watcher, and the fired log keeps the rate limit honest across them.

set -uo pipefail

TRANSCRIPT="${1:?usage: cc-resume-watch <transcript.jsonl> [grace] [poll] [max_per_hour]}"
GRACE="${2:-25}"
POLL="${3:-10}"
MAX_PER_HOUR="${4:-12}"
STATE="${CC_RESUME_STATE:-}"
WINDOW="${CC_RESUME_WINDOW:-3600}"
OWNER="${CC_RESUME_OWNER:-}"

LEDGER="${STATE:+$STATE.resumed}"
FIRED="${STATE:+$STATE.fired}"
PIDFILE="${STATE:+$STATE.pid}"
EXITLOG="${STATE:+$STATE.log}"

# Safe to auto-resume: the stream died, nothing is wrong with the request or the
# account. Anything not listed here, such as out of credits, session limit, /login,
# prompt too long or a refusal, needs a human and is deliberately ignored.
TRANSIENT_RE='Connection lost mid-response|Connection closed mid-response|Response stalled mid-stream|The response stopped arriving|Server error mid-response|went to sleep mid-response|Connection lost before a response was produced|The response stalled before a response was produced|Unable to connect to API|Request timed out'

JQ_LAST='
  [ .[] | select(type == "object") ]
  | map(select(.type == "assistant" or .type == "user"))
  | last
  | select(. != null)
  | select(.isApiErrorMessage == true)
  | [ .uuid,
      ((.timestamp // "")[0:19] + "Z"),
      ((.message.content | if type == "array" then (.[0].text // "") else (. // "") end)
       | gsub("\\s+"; " "))
    ] | @tsv'

# epoch_of <iso8601Z> -> epoch seconds, or 0. BSD date parses with -j -f, GNU
# date with -d. Whatever comes back is digit-checked before any arithmetic.
epoch_of() {
  local e
  e=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null) \
    || e=$(date -u -d "$1" +%s 2>/dev/null) \
    || e=""
  case "$e" in
    "" | *[!0-9]*) printf '0' ;;
    *)             printf '%s' "$e" ;;
  esac
}

# Find the Claude Code process that owns this transcript, by matching the session
# id in the filename against the session registry. Empty means no parent check.
resolve_owner() {
  local sid f
  sid=$(basename "$TRANSCRIPT" .jsonl)
  for f in "$HOME"/.claude/sessions/*.json; do
    [ -f "$f" ] || continue
    if [ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" = "$sid" ]; then
      jq -r '.pid // empty' "$f" 2>/dev/null
      return
    fi
  done
}

# Captured before anything else can fork. The arming hook execs into this script,
# so at this point the parent is the Claude Code process itself.
START_PPID=$PPID

# Resolved before anything can chdir, so a replacement can be spawned later.
SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

[ -z "$OWNER" ] && OWNER=$(resolve_owner)
case "$OWNER" in *[!0-9]*) OWNER="" ;; esac

# owner_gone - has the session this watcher belongs to ended?
#
# The registry is the good signal but it is not always there: a watcher armed at
# SessionStart can start before the session file is written, and a short-lived
# session can be gone from the registry before the watcher ever looks. A watcher
# that never resolves an owner used to poll forever, which is exactly the leak this
# whole mechanism exists to avoid.
#
# So when there is no owner, fall back to the parent. A hook-armed watcher is
# exec'd by Claude Code and keeps it as a parent for as long as it lives, so being
# parented to init means either the session is already gone or this was never
# started by a session at all. Either way there is nothing to watch for.
owner_gone() {
  if [ -n "$OWNER" ]; then
    kill -0 "$OWNER" 2>/dev/null && return 1
    return 0
  fi

  # The session file may only appear once the session has finished starting up.
  OWNER=$(resolve_owner)
  case "$OWNER" in *[!0-9]*) OWNER="" ;; esac
  [ -n "$OWNER" ] && return 1

  local cur
  cur=$(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ')
  case "$cur" in
    "" | *[!0-9]*) return 0 ;;
    1)             return 0 ;;
  esac
  [ "$cur" != "$START_PPID" ] && return 0
  return 1
}

# A watcher that dies quietly leaves the session uncovered, and every arming event
# is activity-driven, so an idle session gets no replacement until someone types.
# One was seen dying mid-session with no way to tell why, so record the reason.
log_exit() {
  [ -n "$EXITLOG" ] || return 0
  mkdir -p "$(dirname "$EXITLOG")" 2>/dev/null
  printf '%s %s pid=%s owner=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$$" "${OWNER:-none}" >> "$EXITLOG"
  return 0
}

# Drop the singleton marker only if it is still ours. A later generation may have
# claimed it after we lost a race, and stealing it back would let two watchers run.
release_pidfile() {
  [ -n "$PIDFILE" ] || return 0
  if [ "$(head -1 "$PIDFILE" 2>/dev/null)" = "$$" ]; then
    rm -f "$PIDFILE"
  fi
  return 0
}

# Put a replacement in the field before going. Only for deaths that are neither the
# session ending nor a resume: respawning on owner-gone would recreate the very leak
# the owner check exists to close. The owner is passed explicitly because the
# replacement is reparented to init the moment we exit, so it cannot use the parent
# fallback to work out what it belongs to.
respawn() {
  [ -n "$OWNER" ] || return 0
  kill -0 "$OWNER" 2>/dev/null || return 0
  release_pidfile
  CC_RESUME_OWNER="$OWNER" CC_RESUME_STATE="$STATE" CC_RESUME_WINDOW="$WINDOW" \
    nohup "$SELF" "$TRANSCRIPT" "$GRACE" "$POLL" "$MAX_PER_HOUR" >/dev/null 2>&1 &
  return 0
}

on_signal() {
  log_exit "signal-$1"
  respawn
  exit 0
}
trap 'on_signal TERM' TERM
trap 'on_signal HUP'  HUP
trap 'on_signal INT'  INT
trap release_pidfile EXIT

# recent_fires - how many resumes are still inside the rate-limit window, pruning
# the log as a side effect so it cannot grow without bound. On disk because a
# watcher only lives until it resumes once, so the count has to outlive it.
recent_fires() {
  local now kept line n=0
  [ -n "$FIRED" ] || { printf '0'; return; }
  [ -f "$FIRED" ] || { printf '0'; return; }
  now=$(date -u +%s); kept=""
  while IFS= read -r line; do
    case "$line" in ''|*[!0-9]*) continue ;; esac
    if [ "$(( now - line ))" -lt "$WINDOW" ]; then kept="$kept$line"$'\n'; n=$(( n + 1 )); fi
  done < "$FIRED"
  printf '%s' "$kept" > "$FIRED"
  printf '%s' "$n"
}

while :; do
  # Claude Code never reaps a detached async hook, so without this the watcher
  # outlives the session it was watching and polls a transcript nobody reads.
  if owner_gone; then
    log_exit "owner-gone"
    exit 0
  fi

  if [ -r "$TRANSCRIPT" ]; then
    # progress/system/attachment rows keep being appended after a dead turn, so only
    # assistant/user entries count as "something continued". A partial final line is
    # dropped by fromjson? rather than failing the whole parse.
    hit=$(tail -n 80 "$TRANSCRIPT" 2>/dev/null \
          | jq -rR 'fromjson? // empty' 2>/dev/null \
          | jq -rs "$JQ_LAST" 2>/dev/null)

    if [ -n "$hit" ]; then
      uuid=${hit%%$'\t'*}; rest=${hit#*$'\t'}
      ts=${rest%%$'\t'*};  text=${rest#*$'\t'}

      already=1
      if [ -n "$LEDGER" ] && [ -f "$LEDGER" ] && grep -qxF "$uuid" "$LEDGER" 2>/dev/null; then
        already=0
      fi

      if [ "$already" -eq 1 ] && [[ "$text" =~ $TRANSIENT_RE ]]; then
        err_epoch=$(epoch_of "$ts")
        now_epoch=$(date -u +%s)

        if [ "$err_epoch" -gt 0 ] && [ "$(( now_epoch - err_epoch ))" -ge "$GRACE" ]; then
          n=$(recent_fires)
          if [ "$n" -ge "$MAX_PER_HOUR" ]; then
            # A tight failure loop, not the usual one-or-two-tries recovery. Stay
            # up and quiet: the window will clear and the session may run for days.
            sleep "$POLL"
            continue
          fi
          if [ -n "$LEDGER" ]; then
            mkdir -p "$(dirname "$LEDGER")" 2>/dev/null
            printf '%s\n' "$uuid" >> "$LEDGER"
          fi
          [ -n "$FIRED" ] && printf '%s\n' "$now_epoch" >> "$FIRED"
          printf '%s\n' "RESUME-WATCH: the previous turn was killed $(( now_epoch - err_epoch ))s ago by a transient stream failure (\"${text}\") and nothing has continued it. Pick up exactly where you left off. Re-run only the step that was cut off, do not restart the task, do not re-summarise, and do not ask the user whether to continue. (resume $(( n + 1 ))/${MAX_PER_HOUR} in the last $(( WINDOW / 60 ))m)" >&2
          log_exit "resumed"
          exit 2
        fi
      fi
    fi
  fi

  sleep "$POLL"
done
